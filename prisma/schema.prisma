generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String    @id @default(cuid())
  passwordHash  String?
  name          String
  role          String?  // "DEV" | "QA" | "BA" | null (pure SM)
  isGuest       Boolean   @default(false)
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  votes            Vote[]
  ticketAssignments TicketAssignment[]
  timeOffs         TimeOff[]
  ownedProjects    Project[]       @relation("OwnedProjects")
  memberships      ProjectMember[]
}

model Project {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now())

  // Quick-комнаты для planning poker без обвязки
  isQuick    Boolean   @default(false)
  accessCode String?   @unique
  expiresAt  DateTime?

  sprintDurationWeeks Int    @default(1)
  sprintStartDay      Int    @default(3) // 0=Sun, 1=Mon, ..., 6=Sat
  sprintNameTemplate  String @default("Sprint {number}")
  taskCoefficient     Float  @default(1.0)

  // Эстимация: COMPOSITE_SP (4-факторная), FIBONACCI_SP, HOURS, DAYS
  estimationMethod      String  @default("COMPOSITE_SP")
  workingHoursPerDay    Int     @default(8)
  // Показывать гистограмму распределения всем (по умолчанию — только SM/host)
  showDistributionToAll Boolean @default(false)

  ownerId String
  owner   User   @relation("OwnedProjects", fields: [ownerId], references: [id])

  activeSprintId String?
  activeSprint   Sprint? @relation("ActiveSprint", fields: [activeSprintId], references: [id], onDelete: SetNull)

  members            ProjectMember[]
  inviteLinks        InviteLink[]
  sprints            Sprint[]
  tickets            Ticket[]
  estimationSessions EstimationSession[]
  spScaleItems       SpScaleItem[]
}

model ProjectMember {
  id            String   @id @default(cuid())
  joinedAt      DateTime @default(now())
  role          String?  // "DEV" | "QA" | "BA" | null
  isScrumMaster Boolean  @default(false)

  userId    String
  user      User    @relation(fields: [userId], references: [id])
  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  @@unique([userId, projectId])
}

model InviteLink {
  id        String   @id @default(cuid())
  token     String   @unique @default(cuid())
  grantsSm  Boolean  @default(false)
  label     String?
  createdAt DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id])
}

model Sprint {
  id        String   @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  estimationSessions EstimationSession[]
  tickets            Ticket[]
  activeInProjects   Project[]           @relation("ActiveSprint")
}

model Ticket {
  id                  String   @id @default(cuid())
  externalId          String?
  externalUrl         String?
  title               String
  description         String?
  acceptanceCriteria  String?
  storyPoints         Int?
  devEffortProportion Float?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  sprintId String?
  sprint   Sprint? @relation(fields: [sprintId], references: [id])

  votes              Vote[]
  ticketAssignments  TicketAssignment[]
  estimationSessions EstimationSession[] @relation("ActiveTicket")
}

model EstimationSession {
  id        String   @id @default(cuid())
  status    String   @default("VOTING") // "VOTING" | "REVEALED" | "COMPLETED"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  sprintId String?
  sprint   Sprint? @relation(fields: [sprintId], references: [id])

  activeTicketId String?
  activeTicket   Ticket? @relation("ActiveTicket", fields: [activeTicketId], references: [id])
}

model Vote {
  id          String   @id @default(cuid())
  // 4-факторный голос (COMPOSITE_SP) — все поля заполнены вместе
  devEffort   Int?
  qaEffort    Int?
  risk        Int?
  uncertainty Int?
  // Простой single-value голос (FIBONACCI_SP / HOURS / DAYS)
  singleValue Float?
  createdAt   DateTime @default(now())

  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([userId, ticketId])
}

model TicketAssignment {
  id           String   @id @default(cuid())
  startDate    DateTime
  durationDays Int
  type         String   // "DEV" | "QA" | "BA"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  parentAssignmentId String?
  parentAssignment   TicketAssignment?  @relation("DevQaDependency", fields: [parentAssignmentId], references: [id])
  childAssignments   TicketAssignment[] @relation("DevQaDependency")
}

model TimeOff {
  id   String   @id @default(cuid())
  date DateTime
  type String   // "VACATION" | "SICK_LEAVE" | "HOLIDAY"

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model SpScaleItem {
  id           String @id @default(cuid())
  value        Int
  label        String
  durationDays Int

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, value])
}
