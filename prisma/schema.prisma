generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String   @id @default(cuid())
  passwordHash  String
  name          String   @unique
  role          String?  // "DEV" | "QA" | null (pure SM)
  isScrumMaster Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  votes            Vote[]
  ticketAssignments TicketAssignment[]
  timeOffs         TimeOff[]
  ownedProjects    Project[]       @relation("OwnedProjects")
  memberships      ProjectMember[]
}

model Project {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  ownerId String
  owner   User   @relation("OwnedProjects", fields: [ownerId], references: [id])

  members            ProjectMember[]
  inviteLinks        InviteLink[]
  sprints            Sprint[]
  tickets            Ticket[]
  estimationSessions EstimationSession[]
}

model ProjectMember {
  id            String   @id @default(cuid())
  joinedAt      DateTime @default(now())
  role          String?  // "DEV" | "QA" | null
  isScrumMaster Boolean  @default(false)

  userId    String
  user      User    @relation(fields: [userId], references: [id])
  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  @@unique([userId, projectId])
}

model InviteLink {
  id        String   @id @default(cuid())
  token     String   @unique @default(cuid())
  grantsSm  Boolean  @default(false)
  label     String?
  createdAt DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id])
}

model Sprint {
  id        String   @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  estimationSessions EstimationSession[]
  tickets            Ticket[]
}

model Ticket {
  id                  String   @id @default(cuid())
  externalId          String?
  externalUrl         String?
  title               String
  description         String?
  acceptanceCriteria  String?
  storyPoints         Int?
  devEffortProportion Float?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  sprintId String?
  sprint   Sprint? @relation(fields: [sprintId], references: [id])

  votes              Vote[]
  ticketAssignments  TicketAssignment[]
  estimationSessions EstimationSession[] @relation("ActiveTicket")
}

model EstimationSession {
  id        String   @id @default(cuid())
  status    String   @default("VOTING") // "VOTING" | "REVEALED" | "COMPLETED"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  sprintId String?
  sprint   Sprint? @relation(fields: [sprintId], references: [id])

  activeTicketId String?
  activeTicket   Ticket? @relation("ActiveTicket", fields: [activeTicketId], references: [id])
}

model Vote {
  id          String   @id @default(cuid())
  devEffort   Int
  qaEffort    Int
  risk        Int
  uncertainty Int
  createdAt   DateTime @default(now())

  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([userId, ticketId])
}

model TicketAssignment {
  id           String   @id @default(cuid())
  startDate    DateTime
  durationDays Int
  type         String   // "DEV" | "QA"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  parentAssignmentId String?
  parentAssignment   TicketAssignment?  @relation("DevQaDependency", fields: [parentAssignmentId], references: [id])
  childAssignments   TicketAssignment[] @relation("DevQaDependency")
}

model TimeOff {
  id   String   @id @default(cuid())
  date DateTime
  type String   // "VACATION" | "SICK_LEAVE" | "HOLIDAY"

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}
