generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String    @id @default(cuid())
  passwordHash  String?
  name          String
  role          String?  // "DEV" | "QA" | "BA" | null (pure SM)
  isGuest       Boolean   @default(false)
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  votes               Vote[]
  ticketAssignments   TicketAssignment[]
  timeOffs            TimeOff[]
  ownedProjects       Project[]          @relation("OwnedProjects")
  memberships         ProjectMember[]
  createdRetros       RetroBoard[]       @relation("CreatedRetros")
  retroCards          RetroCard[]
  retroVotes          RetroVote[]
  assignedRetroActions RetroActionItem[] @relation("AssignedRetroActions")
  retroParticipations RetroParticipant[]
}

model Project {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now())

  // Quick-комнаты для planning poker без обвязки
  isQuick    Boolean   @default(false)
  accessCode String?   @unique
  expiresAt  DateTime?

  sprintDurationWeeks Int    @default(1)
  sprintStartDay      Int    @default(3) // 0=Sun, 1=Mon, ..., 6=Sat
  sprintNameTemplate  String @default("Sprint {number}")
  taskCoefficient     Float  @default(1.0)

  // Эстимация: COMPOSITE_SP (4-факторная), FIBONACCI_SP, HOURS, DAYS
  estimationMethod      String  @default("COMPOSITE_SP")
  workingHoursPerDay    Int     @default(8)
  // Показывать гистограмму распределения всем (по умолчанию — только SM/host)
  showDistributionToAll Boolean @default(false)

  ownerId String
  owner   User   @relation("OwnedProjects", fields: [ownerId], references: [id])

  activeSprintId String?
  activeSprint   Sprint? @relation("ActiveSprint", fields: [activeSprintId], references: [id], onDelete: SetNull)

  members            ProjectMember[]
  inviteLinks        InviteLink[]
  sprints            Sprint[]
  tickets            Ticket[]
  estimationSessions EstimationSession[]
  spScaleItems       SpScaleItem[]
  retroBoards        RetroBoard[]
  retroActionItems   RetroActionItem[]
}

model ProjectMember {
  id            String   @id @default(cuid())
  joinedAt      DateTime @default(now())
  role          String?  // "DEV" | "QA" | "BA" | null
  isScrumMaster Boolean  @default(false)

  userId    String
  user      User    @relation(fields: [userId], references: [id])
  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  @@unique([userId, projectId])
}

model InviteLink {
  id        String   @id @default(cuid())
  token     String   @unique @default(cuid())
  grantsSm  Boolean  @default(false)
  label     String?
  createdAt DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id])
}

model Sprint {
  id        String   @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  estimationSessions EstimationSession[]
  tickets            Ticket[]
  activeInProjects   Project[]           @relation("ActiveSprint")
  retroBoards        RetroBoard[]
}

model Ticket {
  id                  String   @id @default(cuid())
  externalId          String?
  externalUrl         String?
  title               String
  description         String?
  acceptanceCriteria  String?
  storyPoints         Int?
  devEffortProportion Float?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  sprintId String?
  sprint   Sprint? @relation(fields: [sprintId], references: [id])

  votes              Vote[]
  ticketAssignments  TicketAssignment[]
  estimationSessions EstimationSession[] @relation("ActiveTicket")
  retroActionItem    RetroActionItem?
}

model EstimationSession {
  id        String   @id @default(cuid())
  status    String   @default("VOTING") // "VOTING" | "REVEALED" | "COMPLETED"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  sprintId String?
  sprint   Sprint? @relation(fields: [sprintId], references: [id])

  activeTicketId String?
  activeTicket   Ticket? @relation("ActiveTicket", fields: [activeTicketId], references: [id])
}

model Vote {
  id          String   @id @default(cuid())
  // 4-факторный голос (COMPOSITE_SP) — все поля заполнены вместе
  devEffort   Int?
  qaEffort    Int?
  risk        Int?
  uncertainty Int?
  // Простой single-value голос (FIBONACCI_SP / HOURS / DAYS)
  singleValue Float?
  createdAt   DateTime @default(now())

  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([userId, ticketId])
}

model TicketAssignment {
  id           String   @id @default(cuid())
  startDate    DateTime
  durationDays Int
  type         String   // "DEV" | "QA" | "BA"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  parentAssignmentId String?
  parentAssignment   TicketAssignment?  @relation("DevQaDependency", fields: [parentAssignmentId], references: [id])
  childAssignments   TicketAssignment[] @relation("DevQaDependency")
}

model TimeOff {
  id   String   @id @default(cuid())
  date DateTime
  type String   // "VACATION" | "SICK_LEAVE" | "HOLIDAY"

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model SpScaleItem {
  id           String @id @default(cuid())
  value        Int
  label        String
  durationDays Int

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, value])
}

model RetroBoard {
  id                   String    @id @default(cuid())
  title                String
  inviteToken          String    @unique @default(cuid())
  template             String    @default("WENT_WELL_TO_IMPROVE")
  // "WENT_WELL_TO_IMPROVE" | "START_STOP_CONTINUE" | "MAD_SAD_GLAD" | "FOUR_LS" | "SAILBOAT" | "CUSTOM"

  phase                String    @default("COLLECT")
  // "COLLECT" | "GROUP" | "VOTE" | "DISCUSS" | "ACTIONS" | "COMPLETED"

  isAnonymous          Boolean   @default(false)
  hideCardsUntilReveal Boolean   @default(true)
  cardsRevealed        Boolean   @default(false)
  maxVotesPerUser      Int       @default(5)
  hideVotesUntilDone   Boolean   @default(true)

  timerEndsAt          DateTime?
  timerDurationSec     Int?
  focusedItemId        String?

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  completedAt          DateTime?

  projectId            String
  project              Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  sprintId             String?
  sprint               Sprint?   @relation(fields: [sprintId], references: [id], onDelete: SetNull)

  createdById          String
  createdBy            User      @relation("CreatedRetros", fields: [createdById], references: [id])

  columns              RetroColumn[]
  cards                RetroCard[]
  groups               RetroCardGroup[]
  actionItems          RetroActionItem[]
  participants         RetroParticipant[]
}

model RetroColumn {
  id       String     @id @default(cuid())
  title    String
  color    String     @default("emerald") // "emerald" | "amber" | "rose" | "blue" | "violet" | "zinc"
  position Int

  boardId  String
  board    RetroBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)

  cards    RetroCard[]
  groups   RetroCardGroup[]
}

model RetroCardGroup {
  id        String      @id @default(cuid())
  title     String
  position  Int
  createdAt DateTime    @default(now())

  boardId   String
  board     RetroBoard  @relation(fields: [boardId], references: [id], onDelete: Cascade)

  columnId  String
  column    RetroColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)

  cards     RetroCard[]
  votes     RetroVote[]
}

model RetroCard {
  id        String          @id @default(cuid())
  content   String
  position  Int
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  boardId   String
  board     RetroBoard      @relation(fields: [boardId], references: [id], onDelete: Cascade)

  columnId  String
  column    RetroColumn     @relation(fields: [columnId], references: [id], onDelete: Cascade)

  groupId   String?
  group     RetroCardGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  authorId  String
  author    User            @relation(fields: [authorId], references: [id], onDelete: Cascade)

  votes     RetroVote[]
}

model RetroVote {
  id        String          @id @default(cuid())
  weight    Int             @default(1)
  createdAt DateTime        @default(now())

  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  cardId    String?
  card      RetroCard?      @relation(fields: [cardId], references: [id], onDelete: Cascade)

  groupId   String?
  group     RetroCardGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, cardId])
  @@unique([userId, groupId])
}

model RetroActionItem {
  id         String     @id @default(cuid())
  title      String
  status     String     @default("OPEN") // "OPEN" | "DONE"
  dueDate    DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  boardId    String
  board      RetroBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)

  projectId  String
  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  assigneeId String?
  assignee   User?      @relation("AssignedRetroActions", fields: [assigneeId], references: [id], onDelete: SetNull)

  ticketId   String?    @unique
  ticket     Ticket?    @relation(fields: [ticketId], references: [id], onDelete: SetNull)
}

model RetroParticipant {
  id         String     @id @default(cuid())
  joinedAt   DateTime   @default(now())
  lastSeenAt DateTime   @default(now())
  isTyping   Boolean    @default(false)

  boardId    String
  board      RetroBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)

  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([boardId, userId])
}
